{
  "name": "vue-pure-admin",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint --cache --max-warnings 0 src mock build --fix",
    "lint:prettier": "prettier --write \"src/**/*.{js,ts,json,css,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{html,vue,css,scss}\" --cache-location node_modules/.cache/stylelint/",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:stylelint",
    "clean:cache": "rimraf .eslintcache && rimraf pnpm-lock.yaml && rimraf node_modules && pnpm store prune && pnpm install",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [
    "vue-pure-admin",
    "element-plus",
    "unocss",
    "pure-admin",
    "typescript",
    "pinia",
    "vue3",
    "vite",
    "esm"
  ],
  "homepage": "https://github.com/pure-admin/vue-pure-admin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-admin/vue-pure-admin.git"
  },
  "bugs": {
    "url": "https://github.com/pure-admin/vue-pure-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xiaoxian521",
    "email": "pureadmin@163.com",
    "url": "https://github.com/xiaoxian521"
  },
  "dependencies": {
    "@iconify/vue": "4.2.0",
    "@pureadmin/utils": "^2.6.4",
    "@vueuse/core": "^14.3.0",
    "animate.css": "^4.1.1",
    "axios": "1.14.0",
    "element-plus": "^2.14.0",
    "js-cookie": "^3.0.7",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.1",
    "qs": "^6.15.2",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.3",
    "vue-router": "^5.0.7",
    "vue-tippy": "^6.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/carbon": "^1.2.22",
    "@iconify/json": "^2.2.474",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.41",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "boxen": "^8.0.1",
    "code-inspector-plugin": "^1.5.1",
    "cssnano": "^8.0.1",
    "dayjs": "^1.11.20",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "gradient-string": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "postcss-html": "^1.8.1",
    "postcss-load-config": "^6.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.99.0",
    "stylelint": "^17.11.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "unocss": "^66.7.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.13",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-fake-server": "^2.2.4",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-router-warn": "^2.0.0",
    "vite-svg-loader": "^5.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.9"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11"
  }
}
